# Скопируйте этот файл в .env и впишите свои пароли. Файл .env не попадает на GitHub.
SKLAD_PASSWORD_DIRECTOR=
SKLAD_PASSWORD_STOCKMAN=
SKLAD_PASSWORD_MANAGER=
# 1 — без паролей выше вход закрыт (стандартные тестовые пароли не работают)
SKLAD_REQUIRE_ENV_PASSWORDS=1

# Порт и доступ: 127.0.0.1 — только этот компьютер; 0.0.0.0 — ещё и телефоны в той же Wi-Fi сети
PORT=8000
HOST=127.0.0.1
